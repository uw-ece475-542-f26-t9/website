---
import EntryArticle from "../../components/EntryArticle.astro";
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES } from "../../config";
import { getEntries } from "../../lib/entries";

export async function getStaticPaths() {
    const paths = await Promise.all(
        // Single-entry categories show their entry on the tab page itself.
        CATEGORIES.filter((category) => !category.single).map(
            async (category) => {
                const entries = await getEntries(category.id);
                return entries.map((entry, i) => ({
                    params: { category: category.id, slug: entry.id },
                    // entries are sorted newest/first-in-order first, so
                    // "previous" in reading order is the next item in the array.
                    props: {
                        category,
                        entry,
                        prev: entries[i + 1],
                        next: entries[i - 1],
                    },
                }));
            },
        ),
    );
    return paths.flat();
}

const { category, entry, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/${category.id}/${id}/`;
---

<Layout title={entry.data.title} description={entry.data.description}>
    <a class="back" href={`${base}/${category.id}/`}>
        &larr; {category.label}
    </a>
    <EntryArticle entry={entry} />
    <nav class="pager" aria-label="More entries">
        {prev ? <a href={href(prev.id)}>&larr; {prev.data.title}</a> : <span />}
        {next && <a href={href(next.id)}>{next.data.title} &rarr;</a>}
    </nav>
</Layout>

<style>
    .back {
        font-size: 0.9rem;
        text-decoration: none;
    }
    .pager {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }
</style>
