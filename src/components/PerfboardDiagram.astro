    ["#555b61", "GND"],
    ["#d64545", "VBAT (switched battery)"],
    ["#9b1c1c", "Battery + (unswitched)"],
    ["#e07b00", "3.3 V (XIAO)"],
    ["#8a5cd6", "3.0 V (MyoWare regulator)"],
    ["#3b6fd6", "I²C SDA"],
    ["#139aa8", "I²C SCL"],
    ["#2f9e58", "MyoWare ENV"],
    ["#6f9a1f", "Battery sense"],
    ["#b0479a", "Button / OFF"],
